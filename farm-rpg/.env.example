# Kopieren nach .env und anpassen.

# Godot-Version (muss als Tag von barichello/godot-ci existieren; zu config/features in game/project.godot passend)
GODOT_VERSION=4.3

# Dev-Server mit den großen Modellen (nur Host/IP, ohne http://)
DEV_OLLAMA_HOST=
DEV_OLLAMA_PORT=11434

# Welches Ollama nutzt der Agent?
#   http://dev-ollama:11434  -> Dev-Server (Devstral 24B, Qwen 27B)
#   http://ollama:11434      -> lokale 3070
AGENT_OLLAMA_URL=http://dev-ollama:11434

# aider-Modellname (Präfix ollama_chat/ + Ollama-Modellname). Muss in .aider.model.settings.yml stehen.
AGENT_MODEL=ollama_chat/devstral-small-2-24b-instruct-2512-q3_k_l:latest

# Lokale Ollama
OLLAMA_KEEP_ALIVE=10m

# Open WebUI (zufälligen langen Wert setzen)
WEBUI_SECRET_KEY=

# Host-UID/GID (Linux/WSL: `id -u` / `id -g`), damit Dateien im Mount dir gehören
HOST_UID=1000
HOST_GID=1000
